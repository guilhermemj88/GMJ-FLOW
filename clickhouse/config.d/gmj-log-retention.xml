<clickhouse>
    <logger>
        <level replace="1">information</level>
    </logger>

    <query_log>
        <ttl>event_date + INTERVAL 2 DAY DELETE</ttl>
    </query_log>

    <trace_log>
        <ttl>event_date + INTERVAL 1 DAY DELETE</ttl>
    </trace_log>

    <query_views_log>
        <ttl>event_date + INTERVAL 1 DAY DELETE</ttl>
    </query_views_log>

    <part_log>
        <ttl>event_date + INTERVAL 2 DAY DELETE</ttl>
    </part_log>

    <text_log>
        <level replace="1">warning</level>
        <ttl>event_date + INTERVAL 1 DAY DELETE</ttl>
    </text_log>

    <metric_log>
        <ttl>event_date + INTERVAL 1 DAY DELETE</ttl>
    </metric_log>

    <asynchronous_metric_log>
        <ttl>event_date + INTERVAL 1 DAY DELETE</ttl>
    </asynchronous_metric_log>

    <processors_profile_log>
        <ttl>event_date + INTERVAL 1 DAY DELETE</ttl>
    </processors_profile_log>
</clickhouse>
