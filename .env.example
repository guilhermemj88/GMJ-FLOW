CLICKHOUSE_DATABASE=flowdb
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_CONNECT_TIMEOUT_SECONDS=5
CLICKHOUSE_QUERY_TIMEOUT_SECONDS=30
CLICKHOUSE_ADMIN_TIMEOUT_SECONDS=300
BACKEND_PORT=8000
FRONTEND_PORT=8080

# Empty by default. Set an explicit comma-separated origin list only when needed.
API_CORS_ORIGINS=
GMJFLOW_DB_PATH=/app/data/gmjflow.db
GMJFLOW_AUTH_SECRET=change-me-gmj-flow-auth-secret
# Fresh databases create the first admin only when this is explicitly set.
# Leave empty after bootstrap; there is no built-in default password.
GMJFLOW_INITIAL_ADMIN_PASSWORD=
GMJFLOW_AUTH_PASSWORD_MIN_LENGTH=10
GMJFLOW_AUTH_MAX_FAILED_ATTEMPTS=5
GMJFLOW_AUTH_LOCK_MINUTES=15
GMJFLOW_AUTH_RATE_LIMIT_ATTEMPTS=10
GMJFLOW_AUTH_RATE_LIMIT_WINDOW_SECONDS=60
GMJFLOW_AI_CREDENTIAL_KEY=change-me-separate-ai-credential-key
GMJFLOW_RUNTIME_DIR=/app/runtime
GMJFLOW_PROJECT_DIR=/home/noc/GMJ-FLOW/GMJ-FLOW
GMJFLOW_DOCKER_NETWORK=gmj-flow_default
GMJFLOW_COLLECTORS_DIR=
GMJFLOW_COLLECTOR_APPLY_SCRIPT=/app/runtime/scripts/apply_collectors.sh
GMJFLOW_ENABLE_COLLECTOR_APPLY=true
GMJFLOW_SNMP_POLLING_ENABLED=1
GMJFLOW_CALIBRATION_MIN_BPS=10000
GMJFLOW_CALIBRATION_MIN_CONFIDENCE=0.6
GMJFLOW_MAX_RANGE_MINUTES=259200
GMJFLOW_DASHBOARD_CACHE_MODE=auto
GMJFLOW_DASHBOARD_CACHE_MAX_MB=
GMJFLOW_DASHBOARD_CACHE_MAX_ENTRIES=1000
GMJFLOW_DASHBOARD_CACHE_MIN_AVAILABLE_MB=1536
GMJFLOW_DASHBOARD_CACHE_MAX_AVAILABLE_PERCENT=5
GMJFLOW_DASHBOARD_CACHE_MAX_ITEM_MB=8
GMJFLOW_DASHBOARD_CACHE_MEMORY_CHECK_SECONDS=15
GMJFLOW_DASHBOARD_CACHE_SINGLEFLIGHT_TIMEOUT_SECONDS=35
GMJFLOW_DASHBOARD_CACHE_WORKERS=1
GMJFLOW_DASHBOARD_CACHE_PREWARM=false
GMJFLOW_DASHBOARD_CACHE_SCHEMA_VERSION=dashboard-v3
GMJFLOW_ANOMALY_DETECTION_ENABLED=true
GMJFLOW_ANOMALY_INTERVAL_SECONDS=30
GMJFLOW_ANOMALY_LOOKBACK_SECONDS=60
GMJFLOW_ANOMALY_MIN_DURATION_SECONDS=30
GMJFLOW_ANOMALY_CLOSE_AFTER_SECONDS=120
GMJFLOW_AUTO_MITIGATION_ENABLED=true
GMJFLOW_AUTO_MITIGATION_INTERVAL_SECONDS=5
GMJFLOW_AUTO_MITIGATION_MAX_RETRIES=0
GMJFLOW_AUTO_MITIGATION_WITHDRAW_MAX_RETRIES=2
GMJFLOW_BGP_AUTO_CHECK_ENABLED=true
GMJFLOW_BGP_CHECK_INTERVAL_SECONDS=30
GMJFLOW_BGP_STATUS_CHECK_TIMEOUT_SECONDS=45
GMJFLOW_BGP_STATUS_CHECK_WORKERS=4
GMJFLOW_HOST_AGENT_URL=http://172.18.0.1:18080
GMJFLOW_EXABGP_LOG_PATH=/var/log/exabgp-gmj-flow.log
GMJFLOW_EXABGP_CONFIG_PATH=/etc/exabgp/gmj-flow-ne8000.conf
GMJFLOW_EXABGP_SYSTEMD_SERVICE=exabgp-gmj-flow
GMJFLOW_BGP_CLOSE_WAIT_ALERT_THRESHOLD=5
GMJFLOW_BGP_RECV_Q_ALERT_THRESHOLD=0
GMJFLOW_EXABGP_CONFIG_PATH=/etc/exabgp/gmj-flow-ne8000.conf
GMJFLOW_ASN_RESOLVER_ENABLED=true
GMJFLOW_ASN_RESOLVER_BATCH_SIZE=20
GMJFLOW_ASN_RESOLVER_INTERVAL_SECONDS=30
GMJFLOW_ASN_RESOLVER_TIMEOUT_SECONDS=10
GMJFLOW_ASN_RESOLVER_MAX_ATTEMPTS=3
GMJFLOW_ASN_CACHE_TTL_DAYS=30
GMJFLOW_GEOIP_MMDB_PATH=/app/data/GeoLite2-City.mmdb

# Threat Intelligence. Public feeds start enabled; GreyNoise requires a key.
GMJFLOW_THREAT_INTEL_SCHEDULER_ENABLED=true
GMJFLOW_THREAT_INTEL_INITIAL_DELAY_SECONDS=15
GMJFLOW_THREAT_INTEL_HTTP_TIMEOUT_SECONDS=30
GMJFLOW_THREAT_INTEL_GREYNOISE_ENABLED=false
GMJFLOW_THREAT_INTEL_GREYNOISE_INTERVAL_SECONDS=28800
GREYNOISE_API_KEY=
GREYNOISE_GNQL_URL=https://api.greynoise.io/v3/gnql
GMJFLOW_THREAT_INTEL_CEREAL2_ENABLED=true
GMJFLOW_THREAT_INTEL_CEREAL2_INTERVAL_SECONDS=900
CEREAL2_BASE_URL=https://cereal2.botnet.cl
GMJFLOW_CEREAL2_ATTACK_MAX_PAGES=0
GMJFLOW_CEREAL2_ATTACK_RETENTION_DAYS=30
GMJFLOW_THREAT_INTEL_TEAM_CYMRU_ENABLED=true
GMJFLOW_THREAT_INTEL_TEAM_CYMRU_INTERVAL_SECONDS=14400
GMJFLOW_THREAT_INTEL_FEODO_ENABLED=true
GMJFLOW_THREAT_INTEL_FEODO_INTERVAL_SECONDS=900
FEODO_FEED_URL=https://feodotracker.abuse.ch/downloads/ipblocklist.json

# Behavioral Threat Engine starts in shadow mode; auto-policy remains opt-in.
GMJFLOW_BEHAVIORAL_DETECTION_ENABLED=true
GMJFLOW_BEHAVIOR_INITIAL_DELAY_SECONDS=30
GMJFLOW_BEHAVIOR_INTERVAL_SECONDS=30
GMJFLOW_BEHAVIOR_LOOKBACK_SECONDS=300
GMJFLOW_BEHAVIOR_MAX_OBSERVATIONS=100000
GMJFLOW_BEHAVIOR_MAX_PREFIX_GROUPS=50000
GMJFLOW_BEHAVIOR_MAX_INTEL_LOOKUPS_PER_VECTOR=500
GMJFLOW_BEHAVIOR_BASELINE_ALPHA=0.1
GMJFLOW_THREAT_POLICY_AUTO_ENABLED=false
GMJFLOW_THREAT_AI_SHADOW_ENABLED=false
GMJFLOW_THREAT_POLICY_REQUIRE_GROQ=true
GMJFLOW_THREAT_POLICY_MIN_GROQ_CONFIDENCE=0.75
GMJFLOW_THREAT_POLICY_MIN_SCORE=85
GMJFLOW_THREAT_POLICY_MIN_EVIDENCE_SCORE=75
GMJFLOW_THREAT_POLICY_MAX_EVALUATIONS=10
GMJFLOW_THREAT_POLICY_TTL_SECONDS=900
GMJFLOW_THREAT_POLICY_COOLDOWN_SECONDS=300
# Required for automatic FlowSpec: one enabled automatic fixed-connector FlowSpec profile.
GMJFLOW_THREAT_RESPONSE_PROFILE_ID=
# Additional comma-separated ranges that must never be automatically blocked.
GMJFLOW_THREAT_PROTECTED_RANGES=

# Grafana read-only API and deterministic dashboard export.
# Generate a long random token before enabling the integration.
GMJ_FLOW_GRAFANA_TOKEN=
GMJ_FLOW_GRAFANA_PREVIOUS_TOKEN=
GMJ_FLOW_GRAFANA_SCOPES=grafana:data:read,grafana:dashboard:export
GMJ_FLOW_GRAFANA_RATE_LIMIT_PER_MINUTE=120
GMJ_FLOW_GRAFANA_MAX_WINDOW_SECONDS=604800
# A series is delayed after this lag; never lower than one bucket.
GMJ_FLOW_DATA_STALE_AFTER_SECONDS=90

AI_MITIGATION_ENABLED=false
AI_PROVIDER=ollama
AI_BASE_URL=http://gmj-flow-ollama:11434
AI_MODEL_PROFILE=recommended
AI_MODEL=qwen2.5:3b-instruct
AI_TIMEOUT_SECONDS=20
AI_MAX_TOP_FLOWS=30
AI_MAX_CONTEXT_CHARS=12000
AI_NUM_PREDICT=160
AI_ALLOW_AUTO=false
AI_REQUIRE_POLICY_VALIDATION=true

FAKE_FLOW_BATCH_SIZE=1000
FAKE_FLOW_INTERVAL_SECONDS=5

NETFLOW_PORT=9995
PMACCT_SENSOR=mikrotik-lab
PMACCT_EXPORTER_IP=192.168.0.157
PMACCT_OUTPUT_FILE=/var/spool/pmacct/nfacctd.csv
PMACCT_OUTPUT_FORMAT=csv
PMACCT_CSV_DELIMITER=,
PMACCT_CSV_FIELDS=src_as,dst_as,in_iface,out_iface,src_host,dst_host,src_port,dst_port,tcpflags,proto,timestamp_start,packets,bytes
PMACCT_SAMPLE_RATE=1
PMACCT_PARSER_BATCH_SIZE=1000
PMACCT_PARSER_FLUSH_SECONDS=5
PMACCT_STATE_DIR=/var/spool/pmacct/state
PMACCT_PARSER_START_FROM_END_IF_NO_STATE=true
GMJFLOW_PMACCT_ROTATE_ENABLED=true
GMJFLOW_PMACCT_ROTATE_MAX_MB=100
GMJFLOW_PMACCT_ROTATE_KEEP_DAYS=3
GMJFLOW_PMACCT_ROTATE_COMPRESS=true
GMJFLOW_PMACCT_ROTATE_CHECK_SECONDS=30
